{
  "name": "glanzwerk",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run sitemap && npm run icons",
    "serve:ssr:glanzwerk": "node dist/glanzwerk/server/server.mjs",
    "postbuild": "node scripts/finalize-dist.mjs",
    "start:en": "ng serve --configuration en",
    "preview": "npm run build && node scripts/preview.mjs",
    "icons": "node scripts/generate-icon-sprite.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.2.4",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "swiper": "^14.3.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/localize": "^22.2.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "bootstrap-icons": "^1.13.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
